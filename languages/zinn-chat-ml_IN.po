#. Plugin Name of the plugin
#: zinn-chat.php
msgid "Zinn® Chat"
msgstr "Zinn® Chat"

#. Plugin URI of the plugin
#: zinn-chat.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-chat"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-chat"

#. Description of the plugin
#: zinn-chat.php
msgid "A fast, privacy-respecting live chat for your website. Answers visitors with AI when you are busy, hands them to you when they need a person, and emails you anything you miss. Under 10 KB on the page and no requests at all until somebody opens it."
msgstr "നിങ്ങളുടെ വെബ്‌സൈറ്റിനായുള്ള വേഗതയേറിയതും സ്വകാര്യതയെ മാനിക്കുന്നതുമായ ലൈവ് ചാറ്റ്. നിങ്ങൾ തിരക്കിലായിരിക്കുമ്പോൾ AI ഉപയോഗിച്ച് സന്ദർശകർക്ക് മറുപടി നൽകുന്നു, അവർക്ക് ഒരു വ്യക്തിയുടെ സഹായം ആവശ്യമുള്ളപ്പോൾ ചാറ്റ് നിങ്ങൾക്ക് കൈമാറുന്നു, കൂടാതെ നിങ്ങൾക്ക് നഷ്ടമാകുന്ന വിവരങ്ങൾ ഇമെയിൽ വഴി അറിയിക്കുകയും ചെയ്യുന്നു. പേജിൽ 10 KB-ൽ താഴെ മാത്രം വലിപ്പമുള്ളതും, ആരെങ്കിലും തുറക്കുന്നത് വരെ അഭ്യർത്ഥനകളൊന്നും അയക്കാത്തതുമാണ്."

