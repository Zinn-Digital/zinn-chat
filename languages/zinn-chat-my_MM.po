#: includes/pro/class-zinn-chat-pro-admin.php:137
#, php-format
msgid "Using %1$d of %2$d sites."
msgstr "%2$d ခုထဲမှ ဆိုက် %1$d ခုကို အသုံးပြုနေသည်။"

#. translators: %s: comma-separated list of hostnames.
#: includes/pro/class-zinn-chat-pro-admin.php:149
#, php-format
msgid "In use on: %s. Release one from your dashboard, then try again."
msgstr "အသုံးပြုနေသည့်နေရာ- %s။ သင့်ဒက်ရှ်ဘုတ်မှ တစ်ခုအား ထုတ်ပေးပြီးနောက် ထပ်မံကြိုးစားပါ။"

#: includes/pro/class-zinn-chat-pro-admin.php:160
