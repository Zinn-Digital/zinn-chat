#. Plugin Name of the plugin
#: zinn-chat.php
msgid "Zinn® Chat"
msgstr "Zinn® Chat"

#. Plugin URI of the plugin
#: zinn-chat.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-chat"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-chat"

#. Description of the plugin
#: zinn-chat.php
msgid "A fast, privacy-respecting live chat for your website. Answers visitors with AI when you are busy, hands them to you when they need a person, and emails you anything you miss. Under 10 KB on the page and no requests at all until somebody opens it."
msgstr "Brz i privatnost usmeren lajv čet za vaš veb-sajt. Odgovara posetiocima pomoću veštačke inteligencije kada ste zauzeti, prenosi ih vama kada im je potrebna stvarna osoba i šalje vam e-poštu o svemu što propustite. Manji od 10 KB na stranici i bez ikakvih zahteva dok ga neko ne otvori."

#. Author of the plugin
#: zinn-chat.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-chat.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-zinn-chat-admin.php:56
msgid "Settings"
msgstr "Podešavanja"

#: includes/class-zinn-chat-admin.php:151
msgid "That does not look like a Zinn® Chat key. Copy it from the Live chat page of your Zinn Digital® dashboard — it starts with zc_."
msgstr "To ne liči na Zinn® Chat ključ. Kopirajte ga sa stranice Uživo ćaskanje na vašoj Zinn Digital® kontrolnoj tabli — počinje sa zc_."

#: includes/class-zinn-chat-admin.php:161
msgid "Add your chat key before switching the chat on — without it there is nothing for the widget to connect to."
msgstr "Dodajte svoj ključ za ćaskanje pre nego što uključite ćaskanje — bez njega vidžet nema sa čim da se poveže."

#: includes/class-zinn-chat-admin.php:201
msgid "Live chat for this site. Visitors get an answer straight away, you get anything you miss by email, and the whole thing is under 10 KB on the page."
msgstr "Živi chat za ovaj sajt. Posetioci dobijaju odgovor odmah, vi dobijate sve što propustite putem e-pošte, a cela stvar zauzima manje od 10 KB na stranici."

#: includes/class-zinn-chat-admin.php:206
msgid "The chat is live on this site."
msgstr "Ćaskanje je uživo na ovom sajtu."

#: includes/class-zinn-chat-admin.php:208
msgid "The chat is switched off. Nothing is loaded on your site."
msgstr "Čet je isključen. Ništa nije učitano na vašem sajtu."

#: includes/class-zinn-chat-admin.php:217
msgid "Chat key"
msgstr "Ključ za ćaskanje"

#. translators: %s: link to the Zinn dashboard.
#: includes/class-zinn-chat-admin.php:229
#, php-format
msgid "Copy this from the Live chat page of your %s."
msgstr "Kopirajte ovo sa stranice za uživo ćaskanje (Live chat) vašeg %s."

#: includes/class-zinn-chat-admin.php:231
#: includes/pro/class-zinn-chat-pro-admin.php:107
msgid "Zinn Digital® dashboard"
msgstr "Zinn Digital® kontrolna tabla"

#: includes/class-zinn-chat-admin.php:238
msgid "Show the chat"
msgstr "Prikaži ćaskanje"

#: includes/class-zinn-chat-admin.php:245
msgid "Show the chat window to visitors of this site"
msgstr "Prikažite prozor za ćaskanje posetiocima ovog sajta"

#: includes/class-zinn-chat-admin.php:248
msgid "Until you tick this, the plugin adds nothing at all to your pages — no script, no cookie, no requests."
msgstr "Dok ovo ne označite, dodatak ne dodaje apsolutno ništa na vaše stranice – ni skriptu, ni kolačić, ni zahteve."

#. translators: %s: the Zinn Digital trade mark, which is not translated.
#: includes/class-zinn-chat-promo.php:241
#: includes/class-zinn-chat-promo.php:299
#, php-format
msgid "%s — guides and services"
msgstr "%s — vodiči i usluge"

#: includes/class-zinn-chat-promo.php:256
msgid "User guides"
msgstr "Korisnička uputstva"

#. translators: %s: this plugin's name, e.g. "Zinn® Cache".
#: includes/class-zinn-chat-promo.php:306
#, php-format
msgid "Read the %s user guide"
msgstr "Pročitajte %s korisničko uputstvo"

#: includes/class-zinn-chat-promo.php:314
msgid "Hide this"
msgstr "Sakrij ovo"

#: includes/class-zinn-chat-promo.php:374
msgid "Zinn® hosting for WordPress"
msgstr "Zinn® hosting za WordPress"

#: includes/class-zinn-chat-promo.php:375
msgid "LiteSpeed, daily backups, free migration and a control panel built for people who run more than one site."
msgstr "LiteSpeed, dnevne rezervne kopije, besplatna migracija i kontrolna tabla napravljena za ljude koji vode više od jednog sajta."

#: includes/class-zinn-chat-promo.php:381
msgid "The Zinn® marketplace"
msgstr "Zinn® pijaca"

#: includes/class-zinn-chat-promo.php:382
msgid "Buy and sell established sites, domains and link placements, with the money held safely until both sides are happy."
msgstr "Kupujte i prodajite već uspostavljene sajtove, domene i plasmane linkova, uz sigurno čuvanje novca sve dok obe strane ne budu zadovoljne."

#: includes/class-zinn-chat-promo.php:429
msgid "Zinn Hub® — hire people who do this for a living"
msgstr "Zinn Hub® — angažujte ljude koji se time bave profesionalno"

#: includes/class-zinn-chat-promo.php:430
msgid "Our global freelance marketplace: browse over 10,000 ready-made services from writers, designers, developers and SEOs, or post a project and let them bid."
msgstr "Naše globalno tržište frejlansera: pregledajte preko 10.000 gotovih usluga pisaca, dizajnera, programera i SEO stručnjaka, ili objavite projekat i dozvolite im da licitiraju."

#: includes/class-zinn-chat-updater.php:233
msgid "See the Zinn Digital® release notes."
msgstr "Pogledajte beleške o izdanju za Zinn Digital®."

#: includes/class-zinn-chat-updater.php:288
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Preuzeto ažuriranje nije prošlo proveru integriteta i nije instalirano."

#: includes/class-zinn-chat-upsell.php:83
msgid "Everything here keeps working for nothing, for ever. Pro is for when one person answering, and a month of history, stops being enough."
msgstr "Sve ovde nastavlja da radi besplatno, zauvek. Pro je za trenutke kada jedna osoba koja odgovara i mesec dana istorije prestanu da budu dovoljni."

#: includes/class-zinn-chat-upsell.php:86
msgid "As many colleagues answering at once as you like — the free plugin allows one."
msgstr "Onoliko kolega koji odgovaraju u isto vreme koliko želite — besplatni dodatak dozvoljava jednog."

#: includes/class-zinn-chat-upsell.php:87
msgid "Every conversation kept for ever, instead of thirty days."
msgstr "Svaka konverzacija se čuva zauvek, umesto trideset dana."

#: includes/class-zinn-chat-upsell.php:88
msgid "Your own name on the chat window, with ours removed."
msgstr "Vaše sopstveno ime u prozoru za ćaskanje, uz uklonjeno naše."

#: includes/class-zinn-chat-upsell.php:89
msgid "Saved replies, transfer a conversation to a colleague, and business hours."
msgstr "Sačuvani odgovori, prenos razgovora kolegi i radno vreme."

#: includes/class-zinn-chat-upsell.php:90
msgid "5,000 AI answers a month rather than 100."
msgstr "5.000 AI odgovora mesečno umesto 100."

#: includes/class-zinn-chat-upsell.php:91
msgid "Choose exactly which pages the chat appears on — or hide it from the checkout."
msgstr "Izaberite tačno na kojim stranicama se ćaskanje prikazuje — ili ga sakrijte sa stranice za naplatu."

#: includes/class-zinn-chat-upsell.php:92
msgid "One licence covers three of your sites; ten-site licences are available."
msgstr "Jedna licenca pokriva tri vaša sajta; dostupne su licence za deset sajtova."

#: includes/class-zinn-chat-upsell.php:96
msgid "See what Pro costs"
msgstr "Pogledajte koliko košta Pro"

#. translators: %s: link to the customer's licences page.
#: includes/class-zinn-chat-upsell.php:103
#, php-format
msgid "Already host a site with Zinn Digital®? Pro is included free — your key is on the %s."
msgstr "Vec hostujete sajt na Zinn Digital®-u? Pro je besplatno uključen — vaš ključ se nalazi na %s."

#: includes/class-zinn-chat-upsell.php:105
msgid "Licences page of your dashboard"
msgstr "Stranica sa licencama na vašoj kontrolnoj tabli"

#: includes/pro/class-zinn-chat-licence.php:276
msgid "Your licence is active."
msgstr "Vaša licenca je aktivna."

#: includes/pro/class-zinn-chat-licence.php:278
msgid "Your licence has run out but everything still works for a short while. Renew it to keep receiving updates."
msgstr "Vaša licenca je istekla, ali sve i dalje radi još kratko vreme. Obnovite je da biste nastavili da primate ažuriranja."

#: includes/pro/class-zinn-chat-licence.php:280
msgid "We do not recognise that licence key. Copy it again from the Licences page of your Zinn Digital® dashboard."
msgstr "Ne prepoznajemo taj licencni ključ. Kopirajte ga ponovo sa stranice Licences na vašoj Zinn Digital® kontrolnoj tabli."

#: includes/pro/class-zinn-chat-licence.php:282
msgid "That key is for a different Zinn® plugin. The one you want is on the Licences page of your dashboard, next to Zinn® Chat Pro."
msgstr "Taj ključ je za drugi Zinn® dodatak. Onaj koji vam treba nalazi se na stranici Licences vaše kontrolne table, pored Zinn® Chat Pro."

#: includes/pro/class-zinn-chat-licence.php:284
msgid "Your licence has expired. Renew it from your Zinn Digital® dashboard to switch the Pro features back on."
msgstr "Vaša licenca je istekla. Obnovite je sa svoje Zinn Digital® kontrolne table da biste ponovo uključili Pro funkcije."

#: includes/pro/class-zinn-chat-licence.php:286
msgid "This licence has been cancelled."
msgstr "Ova licenca je otkazana."

#: includes/pro/class-zinn-chat-licence.php:288
msgid "This licence is on hold. Please get in touch and we will sort it out."
msgstr "Ova licenca je na čekanju. Molimo vas da stupite u kontakt sa nama i mi ćemo to rešiti."

#: includes/pro/class-zinn-chat-licence.php:290
msgid "There is a billing problem on your Zinn Digital® account. Once it is settled the licence works again straight away."
msgstr "Postoji problem sa naplatom na vašem Zinn Digital® nalogu. Čim se to reši, licenca će odmah ponovo raditi."

#: includes/pro/class-zinn-chat-licence.php:292
msgid "This licence came free with your Zinn® hosting, and that hosting has ended. Buy a licence, or start hosting with us again, to switch Pro back on."
msgstr "Ova licenca je došla besplatno uz vaš Zinn® hosting, a taj hosting je završen. Kupite licencu ili ponovo počnite da koristite naš hosting da biste ponovo uključili Pro."

#: includes/pro/class-zinn-chat-licence.php:294
msgid "Every site on this licence is in use. Release one below, or upgrade to cover more sites."
msgstr "Svaki sajt na ovoj licenci je u upotrebi. Oslobodite jedan ispod ili nadogradite da biste obuhvatili više sajtova."

#: includes/pro/class-zinn-chat-licence.php:296
msgid "We could not confirm your licence just now. Nothing has changed on your site; we will try again shortly."
msgstr "Trenutno nismo mogli da potvrdimo vašu licencu. Na vašem sajtu se ništa nije promenilo; pokušaćemo ponovo uskoro."

#: includes/pro/class-zinn-chat-pro-admin.php:60
msgid "You do not have permission to manage licences on this site."
msgstr "Nemate dozvolu za upravljanje licencama na ovom sajtu."

#: includes/pro/class-zinn-chat-pro-admin.php:87
msgid "Your Pro licence"
msgstr "Vaša Pro licenca"

#: includes/pro/class-zinn-chat-pro-admin.php:94
msgid "Licence key"
msgstr "Licencni ključ"

#. translators: %s: link to the dashboard licences page.
#: includes/pro/class-zinn-chat-pro-admin.php:105
#, php-format
msgid "Copy it from the Licences page of your %s."
msgstr "Kopirajte ga sa stranice Licences vašeg %s."

#. translators: %s: a date.
#: includes/pro/class-zinn-chat-pro-admin.php:121
#, php-format
msgid "Renews on %s."
msgstr "Obnavlja se dana %s."

#. translators: 1: sites in use, 2: sites the licence covers.
#: includes/pro/class-zinn-chat-pro-admin.php:137
#, php-format
msgid "Using %1$d of %2$d sites."
msgstr "Korišćenje %1$d od %2$d sajtova."

#. translators: %s: comma-separated list of hostnames.
#: includes/pro/class-zinn-chat-pro-admin.php:149
#, php-format
msgid "In use on: %s. Release one from your dashboard, then try again."
msgstr "Koristi se na: %s. Oslobođeni jednu sa kontrolne table, pa pokušajte ponovo."

#: includes/pro/class-zinn-chat-pro-admin.php:160
msgid "Save licence"
msgstr "Sačuvaj licencu"

#: includes/pro/class-zinn-chat-pro-admin.php:164
msgid "Remove it from this site"
msgstr "Uklonite ga sa ovog sajta"

#: includes/pro/class-zinn-chat-pro-admin.php:181
msgid "Where the chat appears"
msgstr "Gde se ćaskanje prikazuje"

#: includes/pro/class-zinn-chat-pro-admin.php:193
msgid "Show it"
msgstr "Prikaži"

#: includes/pro/class-zinn-chat-pro-admin.php:197
msgid "Everywhere on this site"
msgstr "Svuda na ovom sajtu"

#: includes/pro/class-zinn-chat-pro-admin.php:198
msgid "Only on the pages I choose below"
msgstr "Samo na stranicama koje izaberem u nastavku"

#: includes/pro/class-zinn-chat-pro-admin.php:199
msgid "Everywhere except the pages I choose below"
msgstr "Svuda osim na stranicama koje izaberem u nastavku"

#: includes/pro/class-zinn-chat-pro-admin.php:215
msgid "Page or post IDs"
msgstr "ID-ovi stranica ili objava"

#: includes/pro/class-zinn-chat-pro-admin.php:223
msgid "Separate them with commas. The ID is in the address bar while you edit a page."
msgstr "Odvojite ih zarezima. ID se nalazi u adresnoj traci dok uređujete stranicu."

#: includes/pro/class-zinn-chat-pro-admin.php:228
msgid "Whole content types"
msgstr "Сви типови садржаја"

#: includes/pro/class-zinn-chat-pro-admin.php:242
msgid "Signed-in visitors"
msgstr "Prijavljeni posetioci"

#: includes/pro/class-zinn-chat-pro-admin.php:249
msgid "Hide the chat from people who are signed in to this site"
msgstr "Sakrijte ćaskanje od ljudi koji su prijavljeni na ovaj sajt"

#: includes/pro/class-zinn-chat-pro-admin.php:254
msgid "Save where it appears"
msgstr "Sačuvaj gde se nalazi"
